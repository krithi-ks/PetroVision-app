# Copy to .env (git-ignored) and adjust. All values are optional.

# cpu | cuda | auto (default)
PETROVISION_DEVICE=auto

# Folder containing the *.pt checkpoints (default: <repo>/models)
# PETROVISION_MODELS_DIR=D:/PetroVision/models

# Individual checkpoint overrides (e.g. large files kept on a drive / Google Drive sync folder)
# PETROVISION_CKPT_DEEPLAB=D:/Drive/PetroVision/models/cv_deeplab_001_best.pt
# PETROVISION_CKPT_MASK2FORMER=D:/Drive/PetroVision/models/cv_mask2former_001_best.pt
# PETROVISION_CKPT_YOLO26=D:/Drive/PetroVision/models/cv_yolo26_001_best.pt
# Which YOLO26 classes count as petroleum-like (comma-separated names; default: all)
# PETROVISION_YOLO26_CLASSES=oil

# Mask2Former needs its (small) config + image-processor files. Default downloads them from
# Hugging Face on first use. For offline use, point to a local folder holding config.json and
# preprocessor_config.json from facebook/mask2former-swin-small-ade-semantic.
# PETROVISION_MASK2FORMER_SOURCE=facebook/mask2former-swin-small-ade-semantic

# Folder with saved experiment results (default: <repo>/results)
# PETROVISION_RESULTS_DIR=D:/PetroVision/results

# How many models may stay in memory at once (least-recently-used is evicted)
PETROVISION_MAX_LOADED_MODELS=3
# Upload limit in MB and cap for the returned mask resolution
PETROVISION_MAX_UPLOAD_MB=25
PETROVISION_MAX_MASK_SIDE=1024


